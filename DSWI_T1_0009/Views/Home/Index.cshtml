@{
    ViewData["Title"] = "Calculadoras";
}

<section class="py-5 text-center">
    <h1 class="display-5 fw-bold">Calculadoras</h1>
    <p class="lead text-muted">Elige una opción para calcular el costo de una llamada o una membresía de gimnasio.</p>
</section>

<div class="row justify-content-center g-4 pb-5">
    <div class="col-md-5 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column text-center p-4">
                <h2 class="h4 card-title">Llamada telefónica</h2>
                <p class="card-text text-muted">Calcula el costo según la duración de la llamada.</p>
                <a class="btn btn-primary mt-auto" asp-controller="Llamadas" asp-action="Index">Ir a llamadas</a>
            </div>
        </div>
    </div>
    <div class="col-md-5 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column text-center p-4">
                <h2 class="h4 card-title">Membresía de gimnasio</h2>
                <p class="card-text text-muted">Calcula la tarifa, el descuento y el total según edad y duración.</p>
                <a class="btn btn-success mt-auto" asp-controller="Gimnasio" asp-action="Index">Ir a gimnasio</a>
            </div>
        </div>
    </div>
</div>
