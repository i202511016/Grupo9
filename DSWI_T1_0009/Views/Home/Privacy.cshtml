
@{
    ViewData["Title"] = "Información del sistema";
}

<div class="container py-4">

    <div class="p-5 mb-4 rounded-4 text-white shadow"
         style="background: linear-gradient(120deg, #12345a, #2563a6);">

        <span class="badge bg-light text-primary mb-3">
            DSWI - CIBERTEC
        </span>

        <h1 class="display-5 fw-bold">Información del sistema</h1>

        <p class="fs-5 mb-0">
            Conoce las tecnologías y funcionalidades de esta aplicación web.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Sobre el proyecto</h4>
                    <p class="text-secondary">
                        Aplicación desarrollada como parte del curso
                        Desarrollo de Servicios Web I de Cibertec.
                    </p>
                    <p class="text-secondary mb-0">
                        El sistema permite realizar cálculos y administrar
                        información de clientes y pedidos.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Tecnologías utilizadas</h4>

                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-primary p-2">C#</span>
                        <span class="badge bg-primary p-2">ASP.NET Core MVC</span>
                        <span class="badge bg-success p-2">Entity Framework Core</span>
                        <span class="badge bg-dark p-2">SQL Server</span>
                        <span class="badge bg-info text-dark p-2">Bootstrap</span>
                        <span class="badge bg-secondary p-2">Repository</span>
                        <span class="badge bg-secondary p-2">Service</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Módulos disponibles</h4>

                    <ul class="text-secondary mb-0">
                        <li>Calculadora de llamadas telefónicas.</li>
                        <li>Calculadora de membresías de gimnasio.</li>
                        <li>Mantenimiento de clientes.</li>
                        <li>Mantenimiento de pedidos.</li>
                    </ul>
                </div>
            </div>
        </div>

    </div>

    <div class="text-center text-secondary mt-4">
        <small>Proyecto académico - Cibertec 2026</small>
    </div>

</div>
