
@model DSWI_T1_0009.Models.Cliente

@{
    ViewData["Title"] = "Registrar cliente";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold text-dark">Registrar cliente</h2>
        <p class="text-secondary">
            Completa los datos para agregar un nuevo cliente.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="card-header text-white p-4"
                     style="background: linear-gradient(120deg, #12345a, #2563a6);">
                    <h5 class="fw-bold mb-0">Información del cliente</h5>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Crear" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Nombre"
                                   class="form-label fw-semibold">
                                Nombre completo
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control form-control-lg"
                                   placeholder="Ingrese el nombre del cliente" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CorreoElectronico"
                                   class="form-label fw-semibold">
                                Correo electrónico
                            </label>

                            <input asp-for="CorreoElectronico"
                                   type="email"
                                   class="form-control form-control-lg"
                                   placeholder="ejemplo@correo.com" />

                            <span asp-validation-for="CorreoElectronico"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary px-4">
                                Guardar cliente
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Volver al listado
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
