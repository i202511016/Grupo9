@model DSWI_T1_0009.Models.LlamadaModel

@{
    ViewData["Title"] = "Cálculo de Llamada Telefónica";
}

<div class="container mt-4 col-md-6">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Costo de Llamada Telefónica</h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="post">
                <div class="mb-3">
                    <label class="form-label">Minutos de la llamada:</label>
                    <input asp-for="Minutos" type="number" min="1" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary">Calcular</button>
            </form>

            @if (Model.TotalPagar.HasValue)
            {
                <div class="alert alert-success mt-3 mb-0">
                    <strong>Total a pagar:</strong> $ @Model.TotalPagar.Value.ToString("0.00")
                </div>
            }
        </div>
    </div>
</div>