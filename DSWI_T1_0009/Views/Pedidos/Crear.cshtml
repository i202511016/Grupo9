@model DSWI_T1_0009.ViewModels.PedidoFormViewModel
@{ ViewData["Title"] = "Registrar pedido"; }
<h1>Registrar pedido</h1>
<form asp-action="Crear" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="FechaPedido" class="form-label">Fecha de pedido</label><input asp-for="FechaPedido" type="date" class="form-control"/><span asp-validation-for="FechaPedido" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Monto" class="form-label"></label><input asp-for="Monto" type="number" step="0.01" class="form-control"/><span asp-validation-for="Monto" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Estado" class="form-label"></label><input asp-for="Estado" class="form-control"/><span asp-validation-for="Estado" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="ClienteId" class="form-label">Cliente</label><select asp-for="ClienteId" class="form-select"><option value="">Seleccione un cliente</option>@foreach (var c in Model.Clientes) { <option value="@c.ClienteId">@c.Nombre (@c.CorreoElectronico)</option> }</select><span asp-validation-for="ClienteId" class="text-danger"></span></div>
<button class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Volver</a></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
