@model IEnumerable<DSWI_T1_0009.Models.Pedido>
@{ ViewData["Title"] = "Pedidos"; }
<h1>Pedidos</h1>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
<p><a asp-action="Crear" class="btn btn-primary">Registrar pedido</a></p>
<table class="table table-striped"><thead><tr><th>ID</th><th>Fecha</th><th>Monto</th><th>Estado</th><th>Cliente</th><th></th></tr></thead><tbody>
@foreach (var p in Model) { <tr><td>@p.PedidoId</td><td>@p.FechaPedido.ToString("yyyy-MM-dd")</td><td>@p.Monto.ToString("0.00")</td><td>@p.Estado</td><td>@p.Cliente?.Nombre</td><td><a asp-action="Editar" asp-route-id="@p.PedidoId" class="btn btn-sm btn-outline-primary">Editar</a></td></tr> }
</tbody></table>
