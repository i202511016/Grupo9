
@model DSWI_T1_0009.ViewModels.PedidoFormViewModel

@{
    ViewData["Title"] = "Editar pedido";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold text-dark">Editar pedido</h2>
        <p class="text-secondary">
            Modifica la información del pedido seleccionado.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="card-header text-white p-4"
                     style="background: linear-gradient(120deg, #12345a, #2563a6);">
                    <h5 class="fw-bold mb-1">
                        Actualizar información del pedido
                    </h5>
                    <small class="opacity-75">
                        Código de pedido: @Model.PedidoId
                    </small>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Editar"
                          asp-route-id="@Model.PedidoId"
                          method="post">

                        <input asp-for="PedidoId" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="FechaPedido"
                                   class="form-label fw-semibold">
                                Fecha del pedido
                            </label>

                            <input asp-for="FechaPedido"
                                   type="date"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="FechaPedido"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Monto"
                                   class="form-label fw-semibold">
                                Monto del pedido
                            </label>

                            <div class="input-group input-group-lg">
                                <span class="input-group-text">$</span>
                                <input asp-for="Monto"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control" />
                            </div>

                            <span asp-validation-for="Monto"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Estado"
                                   class="form-label fw-semibold">
                                Estado del pedido
                            </label>

                            <input asp-for="Estado"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Estado"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ClienteId"
                                   class="form-label fw-semibold">
                                Cliente
                            </label>

                            <select asp-for="ClienteId"
                                    class="form-select form-select-lg">

                                <option value="">
                                    Seleccione un cliente
                                </option>

                                @foreach (var c in Model.Clientes)
                                {
                                    <option value="@c.ClienteId">
                                        @c.Nombre (@c.CorreoElectronico)
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ClienteId"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit" class="btn btn-primary px-4">
                                Guardar cambios
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Volver al listado
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
